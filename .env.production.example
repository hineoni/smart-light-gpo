# Copy to .env on the server and replace every placeholder with a strong secret.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DOMAIN=smart-light.tech
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
EMAIL_CODE_SECRET=replace-with-a-third-long-random-secret

# Public URL used by the compiled Flutter web app. Use the same origin as this site.
API_BASE_URL=https://smart-light.tech
CORS_ALLOWED_ORIGINS=https://smart-light.tech

# Email verification is enabled for production deployments.
VERIFICATION_DELIVERY=email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Smart Light <noreply@example.com>
